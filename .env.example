# OKX Gateway TypeScript - Environment Configuration

# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# OKX API (optional - for private endpoints)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Proxy (for accessing OKX from restricted networks)
HTTP_PROXY=
HTTPS_PROXY=

# Database (optional - for MySQL persistence)
DATABASE_URL=

# Redis (optional - for caching)
REDIS_URL=

# SMTP Notifications
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SENDER=
SMTP_AUTH_CODE=

# Strategy Configuration
CANDLE_BAR=4H
CANDLE_LIMIT=200
UPDATE_INTERVAL=7200
PRICE_UPDATE_INTERVAL=30000
STRATEGY_TICK_INTERVAL=30000
STATE_PERSIST_INTERVAL=60000

# Model
MODEL_DIR=./models
ACTIVE_MODEL=
